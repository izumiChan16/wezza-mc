# Copy to .env, review every value, then run: ./mcctl init
EULA=FALSE

# GitHub Pages URL that ends in /pack.toml
PACKWIZ_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPOSITORY/pack.toml

# Keep 127.0.0.1 for local/tunnel-only access; use 0.0.0.0 for LAN access.
MC_BIND_IP=127.0.0.1
MC_PORT=25565
STAGING_PORT=25566
WORLD_NAME=world
# Empty means random; this only affects a world created after a reset.
WORLD_SEED=
MEMORY=5G
STAGING_MEMORY=5G
TZ=Asia/Taipei
MOTD="Wezza Fabric 26.1.2"
MAX_PLAYERS=10
PUID=1000
PGID=1000

# Existing Windows tunnel software should forward 127.0.0.1:${MC_PORT}.

# Enable after: ./mcctl backup remote-init
# Each start independently defaults to local-auto=off / s3-auto=on.
# Set --s3-auto=off explicitly to start before S3 is ready.
ENABLE_REMOTE_BACKUP=false
RESTIC_REPOSITORY=s3:https://s3.example.com/your-bucket/wezza-mc
RESTIC_HOSTNAME=wezza-home-pc
AWS_DEFAULT_REGION=us-east-1
# Online operations use this per-direction limit; offline operations are unlimited.
S3_ONLINE_LIMIT_KIB=5120
# Decimal bytes; storage service must enforce the hard bucket quota.
S3_CAPACITY_BYTES=100000000000
S3_TARGET_BYTES=80000000000
S3_HIGH_WATER_BYTES=90000000000
