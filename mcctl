      $'whitelist_add\t加入白名单\t允许一名玩家加入' \
      $'whitelist_remove\t移出白名单\t禁止一名玩家再次加入' \
      $'op\t授予 OP\t给予 Minecraft 管理员权限' \
      $'deop\t撤销 OP\t移除 Minecraft 管理员权限' \
      $'__back\t返回\t返回状态总览')"
    case "$selected" in
    online) run_menu_command --read "在线玩家" run_rcon_command list ;;
    whitelist_list) run_menu_command --read "白名单" run_whitelist_command list ;;
    whitelist_add|whitelist_remove|op|deop)
