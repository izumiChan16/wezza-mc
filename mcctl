            run_menu_command "授予 $player OP" run_rcon_command "op $player"
          else menu_cancelled; fi
          ;;
        deop)
          if confirm_yes "要撤销 $player 的 OP 权限吗？"; then
            run_menu_command "撤销 $player 的 OP" run_rcon_command "deop $player"
          else menu_cancelled; fi
          ;;
