#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${ROOT_DIR}/compose.yaml"
DATA_DIR="${ROOT_DIR}/runtime/data"
LOCAL_BACKUP_DIR="${ROOT_DIR}/runtime/backups/local"
OFFLINE_BACKUP_DIR="${ROOT_DIR}/runtime/backups/offline"
STAGING_DIR="${ROOT_DIR}/runtime/staging"
ACCEPTED_FILE="${STAGING_DIR}/ACCEPTED_PACK_SHA256"
RELEASE_FILE="${ROOT_DIR}/site/release.json"

cd "$ROOT_DIR"

info() { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
用法：./mcctl [命令]

交互管理：
  ./mcctl                    在交互终端中打开管理面板
  ./mcctl menu               显式打开管理面板
  ./mcctl menu --plain       使用零依赖的编号菜单
  ./mcctl doctor             检查本机配置和依赖

执行 './mcctl help --all' 查看完整命令参考。
原有 './mcctl start' 等命令仍可用于脚本和故障排查。
EOF
}

usage_all() {
  cat <<'EOF'
Usage: ./mcctl <command>

Server:
  init                         Create .env, secrets, and runtime directories
  start                        Create a pre-session snapshot and start the server
  stop [--skip-remote]         Save, back up, and stop safely
  restart                      Safe stop followed by start
  status                       Show containers and local addresses
  logs                         Follow production server logs
  console                      Attach to the server console (Ctrl-P Ctrl-Q to detach)
  rcon <command...>            Send a Minecraft command through internal RCON
  whitelist add|remove|list    Manage the Minecraft whitelist

World:
  world status                 Show world state, path, seed setting, and archives
  world reset --seed <int>     Archive the world and configure a specific seed
  world reset --random         Archive the world and configure random generation
                               Both reset forms require --confirm and a stopped server

Mods and clients:
  mod list                     List metadata slugs, sides, sources, and names
  mod add <URL-or-slug>        Add from Modrinth, CurseForge, or an HTTPS URL
  mod remove <name>            Remove Packwiz metadata
  mod side <name> <side>       Set client, server, or both explicitly
  mod update <name|all>        Apply a candidate update locally
  mod update-check             Check updates in a disposable copy
  mod check                    Refresh and validate the candidate pack
  mod publish small [--force]  Publish a manual-update release
  mod publish full [--force]   Publish a release that requires re-importing
  client build                 Build the current standard Modrinth .mrpack

Staging:
  stage start                  Start an isolated server on 127.0.0.1:25566
  stage stop                   Stop the isolated server
  stage logs                   Follow staging logs
  stage accept                 Mark the currently tested pack as accepted

Backups:
  backup                       Create an online or offline local backup
  backup delete <archive>      Delete one local archive (requires --confirm)
  backup-list                  List local archives
  backup-delete <archive>      Alias for 'backup delete' (requires --confirm)
  restore-test <archive>       Extract an archive into runtime/restore-test
  restore <archive> --confirm  Recoverably replace production data while stopped
EOF
}

load_settings() {
  if [[ -f "${ROOT_DIR}/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "${ROOT_DIR}/.env"
    set +a
  fi
}

compose() {
  docker compose --project-directory "$ROOT_DIR" -f "$COMPOSE_FILE" "$@"
}

docker_ready() {
  docker info >/dev/null 2>&1 || die "Docker Desktop is not reachable from this WSL distribution."
}

ensure_initialized() {
  [[ -f "${ROOT_DIR}/.env" ]] || die "Missing .env. Run './mcctl init', edit .env, then retry."
  [[ -s "${ROOT_DIR}/secrets/rcon_password.txt" ]] || die "Missing RCON secret. Run './mcctl init'."
  validate_world_config || die "Invalid world configuration in .env."
  mkdir -p "$DATA_DIR" "$LOCAL_BACKUP_DIR" "$OFFLINE_BACKUP_DIR" "$STAGING_DIR"
}

service_running() {
  local service="$1"
  local -a profile_args=()
  case "$service" in
    pack-server|minecraft-staging) profile_args=(--profile staging) ;;
  esac
  compose "${profile_args[@]}" ps --status running --services 2>/dev/null | grep -Fxq "$service"
}

validate_world_config() {
  python3 "${ROOT_DIR}/tools/world_control.py" validate --root "$ROOT_DIR"
}

validate_world_seed() {
  python3 "${ROOT_DIR}/tools/world_control.py" validate-seed --seed "$1"
}

pack_sha256() {
  find "${ROOT_DIR}/pack" -type f -print0 \
    | sort -z \
    | xargs -0 sha256sum \
    | sha256sum \
    | awk '{print $1}'
}

packwiz_run() {
  docker_ready
  compose --profile tools run --rm --no-deps packwiz "$@"
}

packwiz_run_in() {
  local source_dir="$1"
  shift
  docker_ready
  PACK_DIR="$source_dir" compose --profile tools run --rm --no-deps packwiz "$@"
}

candidate_pack_dir() {
  local candidate_dir
  candidate_dir="$(mktemp -d /tmp/wezza-pack-candidate.XXXXXX)"
  cp -a "${ROOT_DIR}/pack/." "$candidate_dir/"
  printf '%s\n' "$candidate_dir"
}

validate_candidate_pack() {
  local candidate_dir="$1"
  packwiz_run_in "$candidate_dir" refresh
  python3 "${ROOT_DIR}/tools/validate_pack.py" "$candidate_dir"
}

promote_candidate_pack() {
  local candidate_dir="$1"
  cp -a "$candidate_dir/." "${ROOT_DIR}/pack/"
}

refresh_and_validate_pack() {
  info "Refreshing Packwiz index"
  packwiz_run refresh
  python3 "${ROOT_DIR}/tools/validate_pack.py" "${ROOT_DIR}/pack"
}

validate_mrpack_safety() {
  local pack_dir="$1"
  python3 "${ROOT_DIR}/tools/release_pack.py" safety \
    --pack-dir "$pack_dir" --approvals "$pack_dir/redistribution.toml"
}

verify_mrpack() {
  local pack_dir="$1" mrpack="$2"
  python3 "${ROOT_DIR}/tools/release_pack.py" verify \
    --pack-dir "$pack_dir" --mrpack "$mrpack"
}

prune_offline_backups() {
  find "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f -name '*.tar.zst' -mtime +14 -delete
  local position=0
  while IFS= read -r archive; do
    position=$((position + 1))
    if (( position > 20 )); then
      rm -f -- "$archive"
    fi
  done < <(find "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f -name '*.tar.zst' -printf '%T@ %p\n' \
    | sort -rn | cut -d' ' -f2-)
}

offline_snapshot() {
  OFFLINE_SNAPSHOT_PATH=""
  mkdir -p "$DATA_DIR" "$OFFLINE_BACKUP_DIR"
  if [[ -z "$(find "$DATA_DIR" -mindepth 1 -print -quit)" ]]; then
    info "No existing server data; skipping the offline snapshot"
    return 0
  fi
  local stamp archive suffix=0
  stamp="$(date '+%Y%m%d-%H%M%S')"
  archive="${OFFLINE_BACKUP_DIR}/wezza-session-start-${stamp}.tar.zst"
  while [[ -e "$archive" ]]; do
    suffix=$((suffix + 1))
    archive="${OFFLINE_BACKUP_DIR}/wezza-session-start-${stamp}-${suffix}.tar.zst"
  done
  info "Creating stopped-state snapshot: ${archive#"${ROOT_DIR}"/}"
  tar --zstd -cf "$archive" \
    --exclude='./logs' --exclude='./cache' --exclude='./*.tmp' \
    -C "$DATA_DIR" .
  prune_offline_backups
  OFFLINE_SNAPSHOT_PATH="$archive"
}

latest_backup() {
  find "$LOCAL_BACKUP_DIR" "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f \
    \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
    -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -n 1 | cut -d' ' -f2-
}

format_bytes() {
  local bytes="${1:-0}" unit_index=0 unit_size=1 whole tenths
  local -a units=(B KiB MiB GiB TiB)
  [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
  while (( bytes >= unit_size * 1024 && unit_index < ${#units[@]} - 1 )); do
    unit_size=$((unit_size * 1024))
    unit_index=$((unit_index + 1))
  done
  if (( unit_index == 0 )); then
    printf '%d B\n' "$bytes"
  else
    whole=$((bytes / unit_size))
    tenths=$((((bytes % unit_size) * 10) / unit_size))
    printf '%d.%d %s\n' "$whole" "$tenths" "${units[unit_index]}"
  fi
}

collect_backup_stats() {
  BACKUP_LOCAL_COUNT=0
  BACKUP_LOCAL_BYTES=0
  BACKUP_OFFLINE_COUNT=0
  BACKUP_OFFLINE_BYTES=0
  local size
  while IFS= read -r -d '' size; do
    [[ "$size" =~ ^[0-9]+$ ]] || continue
    BACKUP_LOCAL_COUNT=$((BACKUP_LOCAL_COUNT + 1))
    BACKUP_LOCAL_BYTES=$((BACKUP_LOCAL_BYTES + size))
  done < <(
    find "$LOCAL_BACKUP_DIR" -maxdepth 1 -type f \
      \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
      -printf '%s\0' 2>/dev/null
  )
  while IFS= read -r -d '' size; do
    [[ "$size" =~ ^[0-9]+$ ]] || continue
    BACKUP_OFFLINE_COUNT=$((BACKUP_OFFLINE_COUNT + 1))
    BACKUP_OFFLINE_BYTES=$((BACKUP_OFFLINE_BYTES + size))
  done < <(
    find "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f \
      \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
      -printf '%s\0' 2>/dev/null
  )
  BACKUP_TOTAL_COUNT=$((BACKUP_LOCAL_COUNT + BACKUP_OFFLINE_COUNT))
  BACKUP_TOTAL_BYTES=$((BACKUP_LOCAL_BYTES + BACKUP_OFFLINE_BYTES))
}

resolve_backup() {
  local requested="$1"
  local requested_name="$requested" requested_scope="" candidate
  case "$requested" in
    local/*)
      requested_scope=local
      requested_name="${requested#local/}"
      ;;
    offline/*)
      requested_scope=offline
      requested_name="${requested#offline/}"
      ;;
  esac
  [[ -n "$requested_name" && "$requested_name" != */* ]] \
    || die "Backup ID must be a filename shown by backup-list."

  local -a candidates=()
  if [[ -z "$requested_scope" || "$requested_scope" == local ]]; then
    candidate="$LOCAL_BACKUP_DIR/$requested_name"
    [[ -f "$candidate" ]] && candidates+=("$candidate")
  fi
  if [[ -z "$requested_scope" || "$requested_scope" == offline ]]; then
    candidate="$OFFLINE_BACKUP_DIR/$requested_name"
    [[ -f "$candidate" ]] && candidates+=("$candidate")
  fi
  case "${#candidates[@]}" in
    0) die "Backup not found: $requested" ;;
    1) printf '%s\n' "${candidates[0]}" ;;
    *) die "Backup name exists in local and offline; use local/$requested_name or offline/$requested_name." ;;
  esac
}

run_local_backup() {
  service_running minecraft || die "The production server is not running."
  if ! service_running backup-local; then
    compose up -d backup-local
  fi
  info "Creating an RCON-coordinated local backup"
  compose exec -T backup-local backup now
}

remote_backup_enabled() {
  [[ "${ENABLE_REMOTE_BACKUP:-false}" == "true" ]]
}

run_remote_backup() {
  [[ -n "${RESTIC_REPOSITORY:-}" ]] || die "ENABLE_REMOTE_BACKUP=true but RESTIC_REPOSITORY is empty."
  [[ -s "${ROOT_DIR}/secrets/restic_password.txt" ]] || die "Missing restic password secret."
  [[ -s "${ROOT_DIR}/secrets/aws_credentials" ]] || die "Missing S3 credentials secret."
  info "Creating the encrypted restic/S3 backup"
  compose --profile remote run --rm --no-deps backup-remote backup now
}

command_init() {
  [[ $# -eq 0 ]] || die "Usage: ./mcctl init"
  if [[ ! -f "${ROOT_DIR}/.env" ]]; then
    cp "${ROOT_DIR}/.env.example" "${ROOT_DIR}/.env"
    info "Created .env; set EULA=TRUE and replace the GitHub Pages URL before starting"
  else
    info ".env already exists; leaving it unchanged"
  fi

  mkdir -p "$DATA_DIR" "$LOCAL_BACKUP_DIR" "$OFFLINE_BACKUP_DIR" "$STAGING_DIR" "${ROOT_DIR}/dist"
  umask 077
  if [[ ! -s "${ROOT_DIR}/secrets/rcon_password.txt" ]]; then
    openssl rand -hex 32 > "${ROOT_DIR}/secrets/rcon_password.txt"
  fi
  if [[ ! -s "${ROOT_DIR}/secrets/restic_password.txt" ]]; then
    openssl rand -base64 48 > "${ROOT_DIR}/secrets/restic_password.txt"
  fi
  if [[ ! -f "${ROOT_DIR}/secrets/aws_credentials" ]]; then
    cp "${ROOT_DIR}/secrets/aws_credentials.example" "${ROOT_DIR}/secrets/aws_credentials"
  fi
  chmod 600 "${ROOT_DIR}/secrets/rcon_password.txt" "${ROOT_DIR}/secrets/restic_password.txt" \
    "${ROOT_DIR}/secrets/aws_credentials"
  info "Runtime directories and local secrets are ready"
}

command_start() {
  [[ $# -eq 0 ]] || die "Usage: ./mcctl start"
  load_settings
  ensure_initialized
  docker_ready
  [[ "${EULA:-FALSE}" == "TRUE" ]] || die "Set EULA=TRUE in .env only after accepting the Minecraft EULA."
  [[ "${PACKWIZ_URL:-}" == https://* ]] || die "PACKWIZ_URL must be an HTTPS Pages URL."
  [[ "${PACKWIZ_URL}" != *YOUR_GITHUB_USER* && "${PACKWIZ_URL}" != *example.invalid* ]] \
    || die "Replace the placeholder PACKWIZ_URL in .env."
  service_running minecraft && die "The production server is already running."

  offline_snapshot
  info "Starting Minecraft and the two-hour local backup scheduler"
  compose up -d minecraft backup-local

  local attempts=0 container_id health
  container_id="$(compose ps -q minecraft)"
  while (( attempts < 60 )); do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id" 2>/dev/null || true)"
    if [[ "$health" == "healthy" ]]; then
      info "Server is healthy on ${MC_BIND_IP:-127.0.0.1}:${MC_PORT:-25565}"
      return 0
    fi
    if [[ "$health" == "exited" || "$health" == "dead" ]]; then
      compose logs --tail 100 minecraft
      die "Server exited during startup."
    fi
    sleep 3
    attempts=$((attempts + 1))
  done
  compose logs --tail 100 minecraft
  die "Server did not become healthy within three minutes."
}

command_stop() {
  [[ $# -eq 0 || ( $# -eq 1 && "$1" == "--skip-remote" ) ]] \
    || die "Usage: ./mcctl stop [--skip-remote]"
  load_settings
  ensure_initialized
  docker_ready
  service_running minecraft || { info "The production server is already stopped"; return 0; }

  local skip_remote=false
  [[ "${1:-}" == "--skip-remote" ]] && skip_remote=true
  compose exec -T minecraft rcon-cli 'say Server stopping in 10 seconds. Saving and backing up...' >/dev/null || true
  sleep 10
  run_local_backup

  if remote_backup_enabled && [[ "$skip_remote" == false ]]; then
    run_remote_backup || die "Remote backup failed; server left running. Retry or use stop --skip-remote."
  fi

  info "Stopping backup scheduler and Minecraft gracefully"
  compose stop -t 120 backup-local minecraft
}

command_status() {
  [[ $# -eq 0 ]] || die "Usage: ./mcctl status"
  load_settings
  docker_ready
  compose --profile staging ps
  printf '\nProduction bind: %s:%s\nStaging bind:    127.0.0.1:%s\n' \
    "${MC_BIND_IP:-127.0.0.1}" "${MC_PORT:-25565}" "${STAGING_PORT:-25566}"
}

command_restart() {
  [[ $# -eq 0 ]] || die "Usage: ./mcctl restart"
  command_stop
  command_start
}

command_production_logs() {
  [[ $# -eq 0 ]] || die "Usage: ./mcctl logs"
  load_settings
  docker_ready
  compose logs -f minecraft
}

command_console() {
  [[ $# -eq 0 ]] || die "Usage: ./mcctl console"
  load_settings
  docker_ready
  [[ -t 0 && -t 1 ]] || die "The Minecraft console requires an interactive WSL terminal."
  service_running minecraft || die "The production server is not running."
  local container_id attach_status
  container_id="$(compose ps --status running -q minecraft)"
  [[ -n "$container_id" ]] || die "The production server container could not be located."
  printf '\nConnected to the production Minecraft console.\n'
  printf 'The console has no prompt; type a command and press Enter. Do not include the leading /.\n'
  printf 'Detach with Ctrl-P, then Ctrl-Q. Ctrl+C is not sent to the Minecraft process.\n\n'
  if docker attach --sig-proxy=false "$container_id"; then
    attach_status=0
  else
    attach_status=$?
  fi
  if service_running minecraft; then
    info "Console detached; the production server is still running."
  else
    warn "Console ended because the production server is no longer running."
  fi
  return "$attach_status"
}

command_world() {
  local action="${1:-status}"
  shift || true
  load_settings
  case "$action" in
    status)
      [[ $# -eq 0 ]] || die "Usage: ./mcctl world status"
      if docker info >/dev/null 2>&1; then
        if service_running minecraft; then
          printf 'Production service: running\n'
        else
          printf 'Production service: stopped\n'
        fi
        if service_running minecraft-staging; then
          printf 'Staging service: running\n'
        else
          printf 'Staging service: stopped\n'
        fi
      else
        printf 'Production service: unknown (Docker unavailable)\n'
        printf 'Staging service: unknown (Docker unavailable)\n'
      fi
      python3 "${ROOT_DIR}/tools/world_control.py" status --root "$ROOT_DIR"
      ;;
    reset)
      local reset_mode="" seed_value="" confirmed=false
      while (( $# > 0 )); do
        case "$1" in
          --seed)
            [[ $# -ge 2 ]] || die "Usage: ./mcctl world reset --seed <integer> --confirm"
            [[ -z "$reset_mode" ]] || die "Choose exactly one of --seed or --random."
            reset_mode=seed
            seed_value="$2"
            shift 2
            ;;
          --random)
            [[ -z "$reset_mode" ]] || die "Choose exactly one of --seed or --random."
            reset_mode=random
            shift
            ;;
          --confirm)
            confirmed=true
            shift
            ;;
          *) die "Usage: ./mcctl world reset --seed <integer> --confirm" ;;
        esac
      done
      [[ -n "$reset_mode" && "$confirmed" == true ]] \
        || die "World reset requires exactly one seed mode and --confirm."
      if [[ "$reset_mode" == seed ]]; then
        validate_world_seed "$seed_value" || die "Invalid world seed."
      fi

      ensure_initialized
      docker_ready
      local service
      for service in minecraft backup-local minecraft-staging pack-server; do
        if service_running "$service"; then
          die "Stop the ${service} service before resetting the world."
        fi
      done

      info "Creating a full offline backup before resetting the world"
      offline_snapshot
      if [[ -n "$OFFLINE_SNAPSHOT_PATH" ]]; then
        info "Offline backup ready: ${OFFLINE_SNAPSHOT_PATH#"${ROOT_DIR}"/}"
      else
        info "No existing server data; there was no world to back up"
      fi

      local -a reset_args=(reset --root "$ROOT_DIR" --confirm)
      if [[ "$reset_mode" == seed ]]; then
        reset_args+=(--seed "$seed_value")
      else
        reset_args+=(--random)
      fi
      python3 "${ROOT_DIR}/tools/world_control.py" "${reset_args[@]}"
      ;;
    *) die "Usage: ./mcctl world status|reset --seed <integer>|--random --confirm" ;;
  esac
}

command_mod() {
  local action="${1:-list}"
  shift || true
  case "$action" in
    list)
      [[ $# -eq 0 ]] || die "Usage: ./mcctl mod list"
      python3 "${ROOT_DIR}/tools/validate_pack.py" "${ROOT_DIR}/pack"
      ;;
    add)
      [[ $# -ge 1 ]] || die "Usage: ./mcctl mod add <URL-or-slug>"
      local source="$1" candidate_dir
      candidate_dir="$(candidate_pack_dir)"
      if [[ "$source" == *curseforge.com/* ]]; then
        if ! packwiz_run_in "$candidate_dir" --yes curseforge add "$source"; then
          rm -rf -- "$candidate_dir"
          die "Packwiz could not add the CurseForge project; the real pack was not changed."
        fi
      elif [[ "$source" == *modrinth.com/* || "$source" != http* ]]; then
        if ! packwiz_run_in "$candidate_dir" --yes modrinth add "$source"; then
          rm -rf -- "$candidate_dir"
          die "Packwiz could not add the Modrinth project; the real pack was not changed."
        fi
      elif [[ "$source" == https://* ]]; then
        local external_name
        external_name="${source##*/}"
        external_name="${external_name%%\?*}"
        external_name="${external_name%.jar}"
        [[ -n "$external_name" ]] || external_name="external-mod"
        if ! packwiz_run_in "$candidate_dir" --yes url add "$external_name" "$source"; then
          rm -rf -- "$candidate_dir"
          die "Packwiz could not add the direct URL; the real pack was not changed."
        fi
        warn "Direct URL added. Verify the author's redistribution license before publishing."
      else
        rm -rf -- "$candidate_dir"
        die "Only Modrinth/CurseForge identifiers or HTTPS URLs are accepted."
      fi
      if ! validate_candidate_pack "$candidate_dir"; then
        rm -rf -- "$candidate_dir"
        die "Candidate validation failed; the real pack was not changed."
      fi
      promote_candidate_pack "$candidate_dir"
      rm -rf -- "$candidate_dir"
      info "Candidate added locally. Run stage start and test it before publishing."
      ;;
    remove)
      [[ $# -eq 1 ]] || die "Usage: ./mcctl mod remove <name>"
      local metadata_name="$1" metadata_path removed_dir
      metadata_name="${metadata_name%.pw.toml}.pw.toml"
      metadata_path="${ROOT_DIR}/pack/mods/${metadata_name}"
      [[ -f "$metadata_path" ]] || die "No metadata file pack/mods/${metadata_name}"
      removed_dir="${ROOT_DIR}/runtime/removed-mods/$(date '+%Y%m%d-%H%M%S')"
      mkdir -p "$removed_dir"
      mv "$metadata_path" "$removed_dir/"
      info "Moved metadata to ${removed_dir#"${ROOT_DIR}"/}; it can be recovered until runtime is cleaned."
      if refresh_and_validate_pack; then
        :
      else
        mv "$removed_dir/$metadata_name" "$metadata_path"
        packwiz_run refresh
        die "Removal validation failed; metadata was restored."
      fi
      ;;
    side)
      [[ $# -eq 2 ]] || die "Usage: ./mcctl mod side <metadata-slug> <client|server|both>"
      [[ "$2" == "client" || "$2" == "server" || "$2" == "both" ]] \
        || die "Side must be client, server, or both."
      local side_name="$1" side_path side_dir
      side_name="${side_name%.pw.toml}.pw.toml"
      side_dir="$(candidate_pack_dir)"
      side_path="${side_dir}/mods/${side_name}"
      if [[ ! -f "$side_path" ]]; then
        rm -rf -- "$side_dir"
        die "No metadata file pack/mods/${side_name}"
      fi
      sed -i -E "s/^side = \"(client|server|both)\"$/side = \"$2\"/" "$side_path"
      if ! grep -Fxq "side = \"$2\"" "$side_path"; then
        rm -rf -- "$side_dir"
        die "Could not update side metadata in $side_name"
      fi
      if ! validate_candidate_pack "$side_dir"; then
        rm -rf -- "$side_dir"
        die "Side change failed validation; the real pack was not changed."
      fi
      promote_candidate_pack "$side_dir"
      rm -rf -- "$side_dir"
      info "Side change is a local candidate until staging and publication."
      ;;
    update)
      [[ $# -eq 1 ]] || die "Usage: ./mcctl mod update <name|all>"
      local update_dir
      update_dir="$(candidate_pack_dir)"
      if [[ "$1" == "all" ]]; then
        if ! packwiz_run_in "$update_dir" --yes update --all; then
          rm -rf -- "$update_dir"
          die "Packwiz update failed; the real pack was not changed."
        fi
      else
        if ! packwiz_run_in "$update_dir" --yes update "$1"; then
          rm -rf -- "$update_dir"
          die "Packwiz update failed; the real pack was not changed."
        fi
      fi
      if ! validate_candidate_pack "$update_dir"; then
        rm -rf -- "$update_dir"
        die "Candidate rejected (for example, an alpha/beta artifact). The real pack was not changed."
      fi
      promote_candidate_pack "$update_dir"
      rm -rf -- "$update_dir"
      info "Updates are local candidates until stage testing and mod publish."
      ;;
    update-check)
      docker_ready
      local check_dir
      check_dir="$(mktemp -d /tmp/wezza-update-check.XXXXXX)"
      cp -a "${ROOT_DIR}/pack/." "$check_dir/"
      info "Checking updates in disposable directory $check_dir"
      if PACK_DIR="$check_dir" compose --profile tools run --rm --no-deps packwiz --yes update --all; then
        diff -ru --exclude=index.toml --exclude=pack.toml "${ROOT_DIR}/pack" "$check_dir" || true
      else
        warn "Packwiz update check failed; the real pack was not changed."
      fi
      rm -rf -- "$check_dir"
      ;;
    check)
      refresh_and_validate_pack
      ;;
    publish)
      local release_type="${1:-}" force=false
      [[ "$release_type" == "small" || "$release_type" == "full" ]] \
        || die "Usage: ./mcctl mod publish <small|full> [--force]"
      shift || true
      if [[ "${1:-}" == "--force" ]]; then
        force=true
        shift || true
      fi
      [[ $# -eq 0 ]] || die "Usage: ./mcctl mod publish <small|full> [--force]"
      refresh_and_validate_pack
      if [[ "$force" == false ]]; then
        [[ -s "$ACCEPTED_FILE" ]] || die "No accepted staging test. Run './mcctl stage accept' or publish --force."
        [[ "$(cat "$ACCEPTED_FILE")" == "$(pack_sha256)" ]] \
          || die "Pack changed after staging acceptance; test and accept it again."
      fi
      git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "This environment has no usable .git repository. Initialize Git before publishing."
      git -C "$ROOT_DIR" remote get-url origin >/dev/null 2>&1 \
        || die "Configure the GitHub remote named origin before publishing."
      [[ "$(git -C "$ROOT_DIR" branch --show-current)" == "main" ]] \
        || die "Releases must be published from the main branch."

      git -C "$ROOT_DIR" diff --quiet HEAD -- . ':(exclude)pack' ':(exclude)site/release.json' \
        || die "Commit non-pack changes before publishing; this command only commits pack/ and site/release.json."
      local outside_untracked
      outside_untracked="$(git -C "$ROOT_DIR" ls-files --others --exclude-standard -- \
        . ':(exclude)pack' ':(exclude)site/release.json')"
      [[ -z "$outside_untracked" ]] \
        || die "Commit or remove non-pack untracked files before publishing: ${outside_untracked//$'\n'/, }"

      git -C "$ROOT_DIR" diff --quiet HEAD -- pack \
        && die "There are no Minecraft, Fabric, or mod changes to publish."

      local publish_dir release_json pack_version exported
      publish_dir="$(candidate_pack_dir)"
      release_json="$(mktemp /tmp/wezza-release.XXXXXX.json)"
      if ! python3 "${ROOT_DIR}/tools/release_pack.py" prepare \
        --pack-dir "$publish_dir" --repo-root "$ROOT_DIR" \
        --release-type "$release_type" --output "$release_json"; then
        rm -rf -- "$publish_dir"
        rm -f -- "$release_json"
        die "Release preparation failed; the real pack was not changed."
      fi
      if ! validate_candidate_pack "$publish_dir"; then
        rm -rf -- "$publish_dir"
        rm -f -- "$release_json"
        die "Versioned release failed Packwiz validation; the real pack was not changed."
      fi
      if ! validate_mrpack_safety "$publish_dir"; then
        rm -rf -- "$publish_dir"
        rm -f -- "$release_json"
        die "MRPACK redistribution safety failed; the real pack was not changed."
      fi
      pack_version="$(python3 "${ROOT_DIR}/tools/release_pack.py" version --pack-dir "$publish_dir")"
      exported="${publish_dir}/wezza-mc-${pack_version}.mrpack"
      if ! packwiz_run_in "$publish_dir" --yes modrinth export --output "$(basename "$exported")"; then
        rm -rf -- "$publish_dir"
        rm -f -- "$release_json"
        die "MRPACK export failed; the real pack was not changed."
      fi
      if ! verify_mrpack "$publish_dir" "$exported"; then
        rm -rf -- "$publish_dir"
        rm -f -- "$release_json"
        die "MRPACK verification failed; the real pack was not changed."
      fi
      rm -f -- "$exported"
      promote_candidate_pack "$publish_dir"
      cp "$release_json" "$RELEASE_FILE"
      python3 "${ROOT_DIR}/tools/release_pack.py" release-check \
        --pack-dir "${ROOT_DIR}/pack" --release "$RELEASE_FILE"
      rm -rf -- "$publish_dir"
      rm -f -- "$release_json"

      git -C "$ROOT_DIR" add pack site/release.json
      git -C "$ROOT_DIR" diff --cached --quiet -- pack site/release.json \
        && die "There are no release changes to publish."
      git -C "$ROOT_DIR" commit -m "chore(pack): publish ${pack_version} (${release_type})" \
        -- pack site/release.json
      git -C "$ROOT_DIR" push origin HEAD
      info "Pushed ${pack_version}. GitHub Pages will build the standard MRPACK."
      ;;
    *) die "Unknown mod action: ${action:-<missing>}" ;;
  esac
}

command_stage() {
  local action="${1:-start}"
  (( $# == 0 )) || shift
  [[ $# -eq 0 ]] || die "Usage: ./mcctl stage start|stop|logs|accept"
  load_settings
  ensure_initialized
  docker_ready
  case "$action" in
    start)
      refresh_and_validate_pack
      if service_running minecraft; then
        run_local_backup
      elif [[ -n "$(find "$DATA_DIR" -mindepth 1 -print -quit)" ]]; then
        offline_snapshot
      fi

      local previous archive
      if [[ -d "${STAGING_DIR}/data" && -n "$(find "${STAGING_DIR}/data" -mindepth 1 -print -quit 2>/dev/null)" ]]; then
        previous="${STAGING_DIR}/data.previous.$(date '+%Y%m%d-%H%M%S')"
        mv "${STAGING_DIR}/data" "$previous"
      fi
      mkdir -p "${STAGING_DIR}/data"
      archive="$(latest_backup || true)"
      if [[ -n "$archive" ]]; then
        info "Restoring $(basename "$archive") into isolated staging data"
        tar -xf "$archive" -C "${STAGING_DIR}/data"
      else
        info "No backup exists; staging will use a new empty world"
      fi
      rm -f -- "$ACCEPTED_FILE"
      compose --profile staging up -d pack-server minecraft-staging
      info "Staging started at 127.0.0.1:${STAGING_PORT:-25566}; inspect logs before acceptance."
      ;;
    stop)
      compose --profile staging stop -t 120 minecraft-staging pack-server
      ;;
    logs)
      compose --profile staging logs -f minecraft-staging
      ;;
    accept)
      service_running minecraft-staging || die "Staging is not running."
      local staging_id staging_health
      staging_id="$(compose --profile staging ps -q minecraft-staging)"
      staging_health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$staging_id")"
      [[ "$staging_health" == "healthy" ]] || die "Staging is not healthy: $staging_health"
      pack_sha256 > "$ACCEPTED_FILE"
      info "Accepted the currently tested Packwiz revision."
      ;;
    *) die "Unknown stage action: $action" ;;
  esac
}

command_backup_list() {
  mkdir -p "$LOCAL_BACKUP_DIR" "$OFFLINE_BACKUP_DIR"
  collect_backup_stats
  printf 'Backup usage:\n'
  printf '  local    %3d archive(s)  %s\n' \
    "$BACKUP_LOCAL_COUNT" "$(format_bytes "$BACKUP_LOCAL_BYTES")"
  printf '  offline  %3d archive(s)  %s\n' \
    "$BACKUP_OFFLINE_COUNT" "$(format_bytes "$BACKUP_OFFLINE_BYTES")"
  printf '  total    %3d archive(s)  %s\n' \
    "$BACKUP_TOTAL_COUNT" "$(format_bytes "$BACKUP_TOTAL_BYTES")"
  if (( BACKUP_TOTAL_COUNT == 0 )); then
    return 0
  fi
  printf '\nArchives:\n'
  local epoch timestamp scope size filename
  while IFS=$'\t' read -r epoch timestamp scope size filename; do
    [[ -n "$filename" ]] || continue
    printf '%s  %-7s %10s  %s\n' \
      "$timestamp" "$scope" "$(format_bytes "$size")" "$filename"
  done < <(
    {
      find "$LOCAL_BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
        -printf '%T@\t%TY-%Tm-%Td %TH:%TM\tlocal\t%s\t%f\n'
      find "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
        -printf '%T@\t%TY-%Tm-%Td %TH:%TM\toffline\t%s\t%f\n'
    } | sort -rn
  )
}

command_backup_delete() {
  [[ $# -eq 2 && "$2" == "--confirm" ]] \
    || die "Usage: ./mcctl backup delete <archive> --confirm"
  local archive requested="$1"
  archive="$(resolve_backup "$requested")"
  [[ ! -L "$archive" ]] || die "Backup ID must refer to a real archive, not a symlink."
  if [[ "$archive" == "$LOCAL_BACKUP_DIR/"* ]] \
    && docker info >/dev/null 2>&1 \
    && service_running backup-local; then
    die "The local backup scheduler is running; stop it before deleting an online archive."
  fi
  info "Deleting backup archive: ${archive#"${ROOT_DIR}"/}"
  rm -f -- "$archive"
  [[ ! -e "$archive" ]] || die "Could not delete backup archive: $requested"
  info "Backup deleted. Remote restic backups, if enabled, were not changed."
}

command_backup() {
  local action="${1:-create}"
  case "$action" in
    create)
      [[ $# -eq 0 || ( $# -eq 1 && "$1" == create ) ]] \
        || die "Usage: ./mcctl backup"
      load_settings
      ensure_initialized
      docker_ready
      if service_running minecraft; then run_local_backup; else offline_snapshot; fi
      ;;
    delete)
      shift
      command_backup_delete "$@"
      ;;
    *) die "Usage: ./mcctl backup [delete <archive> --confirm]" ;;
  esac
}

command_restore_test() {
  [[ $# -eq 1 ]] || die "Usage: ./mcctl restore-test <archive>"
  local archive target
  archive="$(resolve_backup "$1")"
  target="${ROOT_DIR}/runtime/restore-test/$(date '+%Y%m%d-%H%M%S')"
  mkdir -p "$target"
  tar -xf "$archive" -C "$target"
  info "Restored safely to ${target#"${ROOT_DIR}"/}"
}

command_restore() {
  [[ $# -eq 2 && "$2" == "--confirm" ]] || die "Usage: ./mcctl restore <archive> --confirm"
  docker_ready
  service_running minecraft && die "Stop the production server before restoring."
  local archive old_data
  archive="$(resolve_backup "$1")"
  old_data="${ROOT_DIR}/runtime/data.pre-restore.$(date '+%Y%m%d-%H%M%S')"
  mv "$DATA_DIR" "$old_data"
  mkdir -p "$DATA_DIR"
  if ! tar -xf "$archive" -C "$DATA_DIR"; then
    rmdir "$DATA_DIR" 2>/dev/null || true
    mv "$old_data" "$DATA_DIR"
    die "Restore failed; original data was put back."
  fi
  info "Restore complete. Previous data remains at ${old_data#"${ROOT_DIR}"/}"
}

command_client() {
  local action="${1:-}"
  case "$action" in
    build)
      [[ $# -eq 1 ]] || die "Usage: ./mcctl client build"
      local export_dir exported pack_version
      export_dir="$(candidate_pack_dir)"
      if ! validate_candidate_pack "$export_dir"; then
        rm -rf -- "$export_dir"
        die "Pack validation failed; no .mrpack was created."
      fi
      if ! validate_mrpack_safety "$export_dir"; then
        rm -rf -- "$export_dir"
        die "MRPACK redistribution safety failed; no package was created."
      fi
      pack_version="$(python3 "${ROOT_DIR}/tools/release_pack.py" version --pack-dir "$export_dir")"
      exported="${export_dir}/wezza-mc-${pack_version}.mrpack"
      if ! packwiz_run_in "$export_dir" --yes modrinth export --output "$(basename "$exported")"; then
        rm -rf -- "$export_dir"
        die "Packwiz export failed; no .mrpack was created."
      fi
      if [[ ! -f "$exported" ]]; then
        rm -rf -- "$export_dir"
        die "Packwiz did not produce an .mrpack file."
      fi
      if ! verify_mrpack "$export_dir" "$exported"; then
        rm -rf -- "$export_dir"
        die "MRPACK verification failed; no package was kept."
      fi
      mkdir -p "${ROOT_DIR}/dist"
      cp "$exported" "${ROOT_DIR}/dist/wezza-mc-${pack_version}.mrpack"
      cp "$exported" "${ROOT_DIR}/dist/wezza-mc-latest.mrpack"
      rm -rf -- "$export_dir"
      info "Built dist/wezza-mc-${pack_version}.mrpack and dist/wezza-mc-latest.mrpack"
      ;;
    *) die "Usage: ./mcctl client build" ;;
  esac
}

# Interactive dashboard -----------------------------------------------------

MENU_PLAIN=false
MENU_FZF=false

menu_clear() {
  if [[ -t 1 && -n "${TERM:-}" && "${TERM:-dumb}" != "dumb" ]]; then
    tput clear 2>/dev/null || printf '\033[2J\033[H'
  fi
}

menu_pause() {
  [[ "${MCCTL_MENU_NO_PAUSE:-false}" == "true" ]] && return 0
  printf '\n按 Enter 返回菜单……' >&2
  IFS= read -r _ || true
}

menu_select() {
  local title="$1"
  shift
  local selected entry id label description choice index
  local -a ids=()

  if [[ "$MENU_FZF" == true ]]; then
    selected="$(printf '%s\n' "$@" | fzf \
      --height=80% --layout=reverse --border --cycle \
      --delimiter=$'\t' --with-nth=2,3 \
      --prompt='搜索 / 选择 > ' \
      --header="$title  ·  Enter：选择  Esc：返回" || true)"
    [[ -n "$selected" ]] || { printf '%s\n' "__back"; return 0; }
    printf '%s\n' "${selected%%$'\t'*}"
    return 0
  fi

  printf '\n%s\n' "$title" >&2
  printf '%s\n' "────────────────────────────────────────" >&2
  index=0
  for entry in "$@"; do
    index=$((index + 1))
    id="${entry%%$'\t'*}"
    entry="${entry#*$'\t'}"
    label="${entry%%$'\t'*}"
    description="${entry#*$'\t'}"
    ids+=("$id")
    printf '%2d) %s\n    %s\n' "$index" "$label" "$description" >&2
  done
  printf ' q) 返回 / 退出\n' >&2
  while true; do
    printf '请选择：' >&2
    IFS= read -r choice || { printf '%s\n' "__back"; return 0; }
    case "$choice" in
      q|Q|b|B|"") printf '%s\n' "__back"; return 0 ;;
      *[!0-9]*) printf '请输入菜单编号或 q。\n' >&2 ;;
      *)
        if (( choice >= 1 && choice <= ${#ids[@]} )); then
          printf '%s\n' "${ids[choice-1]}"
          return 0
        fi
        printf '没有这个菜单项。\n' >&2
        ;;
    esac
  done
}

prompt_value() {
  local prompt="$1" value
  printf '%s' "$prompt" >&2
  IFS= read -r value || return 1
  [[ -n "$value" ]] || return 1
  printf '%s\n' "$value"
}

confirm_yes() {
  local prompt="$1" answer
  while true; do
    printf '%s [y/N]：' "$prompt" >&2
    IFS= read -r answer || return 1
    case "$answer" in
      y|Y) return 0 ;;
      n|N|"") return 1 ;;
      *) warn "请输入 Y 或 N；直接按 Enter 默认为 N。" ;;
    esac
  done
}

confirm_phrase() {
  local phrase="$1" answer
  printf '请输入完整确认短语 "%s"：' "$phrase" >&2
  IFS= read -r answer || return 1
  [[ "$answer" == "$phrase" ]]
}

run_menu_command() {
  local title="$1"
  shift
  local status
  menu_clear
  printf '=== %s ===\n\n' "$title"
  trap '' INT
  if ( trap - INT; "$@" ); then
    status=0
    printf '\n操作已成功完成。\n'
  else
    status=$?
    if [[ "$status" -eq 130 ]]; then
      printf '\n已中断当前操作，正在返回菜单。\n' >&2
    else
      printf '\n操作失败（退出码 %d），请检查上方信息。\n' "$status" >&2
    fi
  fi
  trap - INT
  MENU_LAST_STATUS="$status"
  [[ "$status" -eq 130 ]] || menu_pause
  return 0
}

dashboard_collect() {
  DASH_INITIALIZED=false
  DASH_CONFIG="missing"
  DASH_DOCKER="unavailable"
  DASH_PRODUCTION="unknown"
  DASH_STAGING="unknown"
  DASH_PACK_VERSION="unknown"
  DASH_PACK_DIRTY=false
  DASH_PACK_ACCEPTED=false
  DASH_LATEST_BACKUP="none"
  DASH_BACKUP_USAGE="0 个 · 0 B"
  DASH_REMOTE_BACKUP="disabled"
  DASH_PRODUCTION_ADDRESS="${MC_BIND_IP:-127.0.0.1}:${MC_PORT:-25565}"
  DASH_RECOMMENDED_ID="doctor"
  DASH_RECOMMENDED_LABEL="运行环境诊断"

  if [[ -f "${ROOT_DIR}/.env" ]]; then
    DASH_INITIALIZED=true
    if load_settings; then
      DASH_PRODUCTION_ADDRESS="${MC_BIND_IP:-127.0.0.1}:${MC_PORT:-25565}"
      if validate_world_config >/dev/null 2>&1 \
        && [[ "${PACKWIZ_URL:-}" == https://* ]] \
        && [[ "${PACKWIZ_URL:-}" != *YOUR_GITHUB_USER* ]] \
        && [[ "${PACKWIZ_URL:-}" != *example.invalid* ]] \
        && [[ -s "${ROOT_DIR}/secrets/rcon_password.txt" ]] \
        && [[ -s "${ROOT_DIR}/secrets/restic_password.txt" ]] \
        && [[ -s "${ROOT_DIR}/secrets/aws_credentials" ]]; then
        if [[ "${EULA:-FALSE}" == "TRUE" ]]; then
          DASH_CONFIG="ready"
        else
          DASH_CONFIG="EULA not accepted"
        fi
      else
        DASH_CONFIG="needs attention"
      fi
      [[ "${ENABLE_REMOTE_BACKUP:-false}" == "true" ]] && DASH_REMOTE_BACKUP="enabled"
    else
      DASH_CONFIG="invalid shell syntax"
    fi
  fi

  local running_services="" container_id health
  if docker info >/dev/null 2>&1; then
    DASH_DOCKER="ready"
    running_services="$(compose --profile staging ps --status running --services 2>/dev/null || true)"
    if grep -Fxq minecraft <<< "$running_services"; then
      DASH_PRODUCTION="running"
      container_id="$(compose ps -q minecraft 2>/dev/null || true)"
      health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' \
        "$container_id" 2>/dev/null || true)"
      [[ -n "$health" ]] && DASH_PRODUCTION="$health"
    else
      DASH_PRODUCTION="stopped"
    fi
    if grep -Fxq minecraft-staging <<< "$running_services"; then
      DASH_STAGING="running"
      container_id="$(compose --profile staging ps -q minecraft-staging 2>/dev/null || true)"
      health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' \
        "$container_id" 2>/dev/null || true)"
      [[ -n "$health" ]] && DASH_STAGING="$health"
    else
      DASH_STAGING="stopped"
    fi
  fi

  if [[ -f "${ROOT_DIR}/pack/pack.toml" ]]; then
    DASH_PACK_VERSION="$(python3 "${ROOT_DIR}/tools/release_pack.py" version \
      --pack-dir "${ROOT_DIR}/pack" 2>/dev/null || printf 'unknown')"
  fi
  if git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    [[ -n "$(git -C "$ROOT_DIR" status --porcelain=v1 -- pack 2>/dev/null || true)" ]] \
      && DASH_PACK_DIRTY=true
  fi
  if [[ -s "$ACCEPTED_FILE" ]]; then
    local accepted_hash current_hash
    accepted_hash="$(<"$ACCEPTED_FILE")"
    current_hash="$(pack_sha256 2>/dev/null || true)"
    [[ -n "$current_hash" && "$accepted_hash" == "$current_hash" ]] && DASH_PACK_ACCEPTED=true
  fi

  local backup
  backup="$(latest_backup 2>/dev/null || true)"
  if [[ -n "$backup" ]]; then
    DASH_LATEST_BACKUP="$(date -r "$backup" '+%Y-%m-%d %H:%M' 2>/dev/null || printf 'unknown') · $(basename "$backup")"
  fi
  collect_backup_stats
  DASH_BACKUP_USAGE="${BACKUP_TOTAL_COUNT} 个 · $(format_bytes "$BACKUP_TOTAL_BYTES")"

  if [[ "$DASH_INITIALIZED" == false || "$DASH_CONFIG" != "ready" ]]; then
    DASH_RECOMMENDED_ID="setup"
    DASH_RECOMMENDED_LABEL="完成初始化与本机配置"
  elif [[ "$DASH_DOCKER" != "ready" ]]; then
    DASH_RECOMMENDED_ID="doctor"
    DASH_RECOMMENDED_LABEL="启动 Docker Desktop 或运行诊断"
  elif [[ "$DASH_PACK_DIRTY" == true && "$DASH_PACK_ACCEPTED" == false \
    && ( "$DASH_STAGING" == "running" || "$DASH_STAGING" == "healthy" ) ]]; then
    DASH_RECOMMENDED_ID="stage_accept"
    DASH_RECOMMENDED_LABEL="接受已经测试的候选整合包"
  elif [[ "$DASH_PACK_DIRTY" == true && "$DASH_PACK_ACCEPTED" == false \
    && ( "$DASH_STAGING" == "starting" || "$DASH_STAGING" == "unhealthy" ) ]]; then
    DASH_RECOMMENDED_ID="stage_logs"
    DASH_RECOMMENDED_LABEL="查看测试服日志并等待其恢复健康"
  elif [[ "$DASH_PACK_DIRTY" == true && "$DASH_PACK_ACCEPTED" == false ]]; then
    DASH_RECOMMENDED_ID="stage_start"
    DASH_RECOMMENDED_LABEL="启动测试服验证整合包变更"
  elif [[ "$DASH_PACK_DIRTY" == true && "$DASH_PACK_ACCEPTED" == true ]]; then
    DASH_RECOMMENDED_ID="publish"
    DASH_RECOMMENDED_LABEL="发布已接受的整合包变更"
  elif [[ "$DASH_PRODUCTION" == "stopped" ]]; then
    DASH_RECOMMENDED_ID="start"
    DASH_RECOMMENDED_LABEL="启动正式服务器"
  else
    DASH_RECOMMENDED_ID="server_status"
    DASH_RECOMMENDED_LABEL="查看正式服务器详情"
  fi
}

dashboard_render() {
  local pack_state="无候选变更" config_state docker_state production_state staging_state remote_state latest_backup
  [[ "$DASH_PACK_DIRTY" == true ]] && pack_state="有待测试的候选变更"
  [[ "$DASH_PACK_ACCEPTED" == true ]] && pack_state="候选变更已接受"
  case "$DASH_CONFIG" in
    ready) config_state="就绪" ;;
    missing) config_state="缺少 .env" ;;
    "EULA not accepted") config_state="尚未接受 EULA" ;;
    "needs attention") config_state="需要处理" ;;
    "invalid shell syntax") config_state=".env 语法错误" ;;
    *) config_state="$DASH_CONFIG" ;;
  esac
  case "$DASH_DOCKER" in ready) docker_state="可用" ;; *) docker_state="不可用" ;; esac
  case "$DASH_PRODUCTION" in
    healthy) production_state="健康" ;; running) production_state="运行中" ;;
    starting) production_state="启动中" ;; unhealthy) production_state="不健康" ;;
    stopped) production_state="已停止" ;; *) production_state="未知" ;;
  esac
  case "$DASH_STAGING" in
    healthy) staging_state="健康" ;; running) staging_state="运行中" ;;
    starting) staging_state="启动中" ;; unhealthy) staging_state="不健康" ;;
    stopped) staging_state="已停止" ;; *) staging_state="未知" ;;
  esac
  case "$DASH_REMOTE_BACKUP" in enabled) remote_state="已启用" ;; *) remote_state="未启用" ;; esac
  latest_backup="$DASH_LATEST_BACKUP"
  [[ "$latest_backup" == "none" ]] && latest_backup="暂无"
  menu_clear
  cat <<EOF
Wezza MC 管理面板
────────────────────────────────────────────────────────────
本机配置      $config_state
Docker        $docker_state
正式服务器    $production_state · $DASH_PRODUCTION_ADDRESS
测试服务器    $staging_state
整合包        $DASH_PACK_VERSION · $pack_state
最新备份      $latest_backup
本机备份      $DASH_BACKUP_USAGE
远端备份      $remote_state
────────────────────────────────────────────────────────────
建议操作      $DASH_RECOMMENDED_LABEL
EOF
}

doctor_item() {
  local level="$1" label="$2" detail="$3"
  printf '%-5s %-24s %s\n' "$level" "$label" "$detail"
}

command_doctor() {
  local failures=0 warnings=0 dependency
  printf 'Wezza MC 环境诊断\n\n'
  for dependency in bash python3 git docker tar zstd openssl; do
    if command -v "$dependency" >/dev/null 2>&1; then
      doctor_item OK "$dependency" "$(command -v "$dependency")"
    else
      doctor_item FAIL "$dependency" "缺少必需命令"
      failures=$((failures + 1))
    fi
  done
  if command -v fzf >/dev/null 2>&1; then
    doctor_item OK fzf "可使用方向键搜索菜单"
  else
    doctor_item WARN fzf "未安装，将自动使用编号菜单"
    warnings=$((warnings + 1))
  fi
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    doctor_item OK "Docker Compose" "CLI 插件可用"
  else
    doctor_item FAIL "Docker Compose" "缺少 docker compose CLI 插件"
    failures=$((failures + 1))
  fi

  if [[ -f "${ROOT_DIR}/.env" ]]; then
    doctor_item OK .env "文件存在"
    if load_settings && validate_world_config >/dev/null 2>&1; then
      doctor_item OK "世界配置" "有效"
    else
      doctor_item FAIL "世界配置" "无效，请编辑 .env 后重试"
      failures=$((failures + 1))
    fi
    if [[ "${EULA:-FALSE}" == "TRUE" ]]; then
      doctor_item OK EULA "已由本机管理员接受"
    else
      doctor_item WARN EULA "请本人阅读 Minecraft EULA 后设置 EULA=TRUE"
      warnings=$((warnings + 1))
    fi
    if [[ "${PACKWIZ_URL:-}" == https://* \
      && "${PACKWIZ_URL:-}" != *YOUR_GITHUB_USER* \
      && "${PACKWIZ_URL:-}" != *example.invalid* ]]; then
      doctor_item OK PACKWIZ_URL "$PACKWIZ_URL"
    else
      doctor_item FAIL PACKWIZ_URL "必须是真实的 HTTPS pack.toml 地址"
      failures=$((failures + 1))
    fi
  else
    doctor_item FAIL .env "缺少，请执行 './mcctl init'"
    failures=$((failures + 1))
  fi

  local secret secret_mode secret_mode_value
  for secret in rcon_password.txt restic_password.txt aws_credentials; do
    if [[ -s "${ROOT_DIR}/secrets/${secret}" ]]; then
      secret_mode="$(stat -c '%a' "${ROOT_DIR}/secrets/${secret}" 2>/dev/null || printf 'unknown')"
      if [[ "$secret_mode" =~ ^[0-7]{3,4}$ ]]; then
        secret_mode_value="$(printf '%d' "0${secret_mode}" 2>/dev/null || printf '511')"
      else
        secret_mode_value=511
      fi
      if (( (secret_mode_value & 63) == 0 )); then
        doctor_item OK "secrets/$secret" "文件存在，权限 $secret_mode"
      else
        doctor_item WARN "secrets/$secret" "权限 $secret_mode 过宽，建议 chmod 600"
        warnings=$((warnings + 1))
      fi
    else
      doctor_item FAIL "secrets/$secret" "缺少或为空，请执行 './mcctl init'"
      failures=$((failures + 1))
    fi
  done

  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    doctor_item OK Docker "守护进程可访问"
    if compose config --quiet >/dev/null 2>&1; then
      doctor_item OK Compose "配置有效"
    else
      doctor_item FAIL Compose "配置校验失败"
      failures=$((failures + 1))
    fi
  else
    doctor_item WARN Docker "不可用，请启动 Docker Desktop 并启用 WSL integration"
    warnings=$((warnings + 1))
  fi

  if python3 "${ROOT_DIR}/tools/release_pack.py" release-check \
    --pack-dir "${ROOT_DIR}/pack" --release "$RELEASE_FILE" >/dev/null 2>&1; then
    doctor_item OK "发布元数据" "与当前整合包一致"
  else
    doctor_item FAIL "发布元数据" "release-check 校验失败"
    failures=$((failures + 1))
  fi

  printf '\n诊断完成：%d 个错误，%d 个警告。\n' "$failures" "$warnings"
  (( failures == 0 ))
}

run_rcon_command() {
  [[ $# -ge 1 ]] || die "Usage: ./mcctl rcon <command...>"
  load_settings
  docker_ready
  service_running minecraft || die "The production server is not running."
  compose exec -T minecraft rcon-cli "$*"
}

run_whitelist_command() {
  local action="${1:-}" player="${2:-}"
  case "$action" in
    add|remove)
      [[ $# -eq 2 && -n "$player" ]] || die "Usage: ./mcctl whitelist add|remove <player>"
      run_rcon_command "whitelist $action $player"
      ;;
    list)
      [[ $# -eq 1 ]] || die "Usage: ./mcctl whitelist list"
      run_rcon_command 'whitelist list'
      ;;
    *) die "Usage: ./mcctl whitelist add|remove|list [player]" ;;
  esac
}

menu_cancelled() {
  info "操作已取消，没有进行任何更改。"
}

prompt_player() {
  local player
  player="$(prompt_value 'Minecraft 玩家名：')" || return 1
  if [[ ! "$player" =~ ^[A-Za-z0-9_]{3,16}$ ]]; then
    warn "玩家名必须由 3–16 个英文字母、数字或下划线组成。"
    return 1
  fi
  printf '%s\n' "$player"
}

select_mod_slug() {
  local path slug name selected
  local -a entries=()
  for path in "${ROOT_DIR}"/pack/mods/*.pw.toml; do
    [[ -f "$path" ]] || continue
    slug="$(basename "$path" .pw.toml)"
    name="$(sed -n 's/^name = "\(.*\)"$/\1/p' "$path" | head -n 1)"
    [[ -n "$name" ]] || name="Packwiz metadata"
    entries+=("${slug}"$'\t'"${slug}"$'\t'"${name}")
  done
  (( ${#entries[@]} > 0 )) || { warn "没有找到模组元数据。"; return 1; }
  selected="$(menu_select '选择模组' "${entries[@]}")"
  [[ "$selected" != "__back" ]] || return 1
  printf '%s\n' "$selected"
}

select_backup_id() {
  local epoch scope size filename timestamp selected
  local -a entries=()
  while IFS=$'\t' read -r epoch scope size filename; do
    [[ -n "$filename" ]] || continue
    timestamp="$(date -d "@${epoch%.*}" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '时间未知')"
    entries+=("${scope}/${filename}"$'\t'"${scope}/${filename}"$'\t'"${timestamp} · $(format_bytes "$size")")
  done < <(
    {
      find "$LOCAL_BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
        -printf '%T@\tlocal\t%s\t%f\n' 2>/dev/null
      find "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
        -printf '%T@\toffline\t%s\t%f\n' 2>/dev/null
    } | sort -rn
  )
  (( ${#entries[@]} > 0 )) || { warn "没有找到本机备份归档。"; return 1; }
  selected="$(menu_select '选择备份归档' "${entries[@]}")"
  [[ "$selected" != "__back" ]] || return 1
  printf '%s\n' "$selected"
}

menu_edit_env() {
  [[ -f "${ROOT_DIR}/.env" ]] || command_init
  local editor_value="${VISUAL:-${EDITOR:-nano}}"
  local -a editor_command=()
  read -r -a editor_command <<< "$editor_value"
  (( ${#editor_command[@]} > 0 )) || die "VISUAL 和 EDITOR 均为空。"
  command -v "${editor_command[0]}" >/dev/null 2>&1 \
    || die "找不到编辑器 ${editor_command[0]}，请设置 VISUAL 或 EDITOR。"
  info "正在打开 .env；只有本人阅读 Minecraft EULA 后才可设置 EULA=TRUE。"
  "${editor_command[@]}" "${ROOT_DIR}/.env"
  validate_world_config || die "保存后的世界配置无效。"
  info "已保存 .env 并校验世界设置；可运行 doctor 完成全部检查。"
}

