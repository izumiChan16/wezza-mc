        if ! validate_world_seed "$seed" >/dev/null 2>&1; then
          warn "Minecraft 种子不是有效的有符号 64 位整数。"
          menu_pause
          continue
        fi
      else
        seed="随机"
      fi
      load_settings || { warn "无法加载 .env。"; menu_pause; continue; }
      world_name="${WORLD_NAME:-world}"
      phrase="RESET $world_name"
      printf '\n目标世界：%s\n新种子：%s\n正式服和测试服必须停止；操作前会先创建完整快照。\n' \
        "$world_name" "$seed" >&2
      if ! confirm_phrase "$phrase"; then menu_cancelled; continue; fi
      if [[ "$mode" == "seed" ]]; then
        run_menu_command "重置世界 $world_name" command_world reset --seed "$seed" --confirm
      else
        run_menu_command "重置世界 $world_name" command_world reset --random --confirm
      fi
      [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
      ;;
    backup_create) run_menu_command "创建备份" command_backup ;;
    backup_list) run_menu_command --read "本机备份归档" command_backup_list ;;
    restore_test)
      backup_id="$(select_backup_id)" || continue
      run_menu_command --read "测试恢复 $backup_id" command_restore_test "$backup_id"
      ;;
    restore)
      backup_id="$(select_backup_id)" || continue
      printf '\n正式服必须停止；现有数据会保留为 data.pre-restore.*。\n' >&2
      if confirm_phrase "RESTORE $backup_id"; then
        run_menu_command "从 $backup_id 恢复正式服" command_restore "$backup_id" --confirm
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
      else menu_cancelled; fi
      ;;
    backup_delete)
      backup_id="$(select_backup_id)" || continue
      printf '\n这会永久删除一个本机归档，不影响远端 restic 快照。\n' >&2
      if confirm_yes "确认删除 $backup_id 吗？"; then
        run_menu_command "删除备份 $backup_id" command_backup_delete "$backup_id" --confirm
      else menu_cancelled; fi
      ;;
    __back) return 0 ;;
    esac
  done
}

menu_publish_handoff() {
  local selected release_type menu_title
  while true; do
    menu_prepare_title menu_title '下一步：发布已测试的整合包'
    selected="$(menu_select "$menu_title" \
      $'small\t发布小更新\t玩家按照更新说明手工更新' \
      $'full\t发布完整更新\t玩家需要重新导入客户端整合包' \
      $'later\t稍后发布\t保留验收记录，回到主菜单')"
    case "$selected" in
      small|full)
        release_type="$selected"
        printf '\n发布会提交整合包与发布元数据，并推送到 origin。\n' >&2
        if confirm_yes "现在发布 $release_type 更新吗？"; then
          run_menu_command "发布 $release_type 更新" command_mod publish "$release_type"
          [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        else
          menu_cancelled
        fi
        ;;
      later|__back)
        MENU_NOTICE="已完成测试；发布已留到稍后"
        return 0
        ;;
    esac
  done
}

menu_pack_workflow() {
  local selected menu_title current_sha delete_option
  local -a entries=()
  while true; do
    dashboard_collect
    entries=()
    menu_title="整合包维护 · $DASH_WORKFLOW"
    menu_prepare_title menu_title "$menu_title"

    if [[ "$DASH_SESSION_STATE" == "active" ]]; then
      current_sha="$(pack_sha256 2>/dev/null || true)"
      if [[ -z "$current_sha" || "$DASH_SESSION_PACK_SHA" != "$current_sha" ]]; then
        entries+=(
          $'rebuild\t用最新变更重建测试服\t沿用本次备份，不再重复备份正式服'
        )
      elif [[ "$DASH_STAGING" == "healthy" ]]; then
        entries+=(
          $'finish\t测试没有问题：完成并清理\t接受当前整合包、停止测试服并删除测试副本'
        )
      elif [[ "$DASH_STAGING" == "stopped" || "$DASH_STAGING" == "unknown" ]]; then
        entries+=(
          $'resume\t继续这次测试\t沿用测试副本和备份，不创建新备份'
        )
      fi
      if [[ "$DASH_STAGING" != "stopped" && "$DASH_STAGING" != "unknown" ]]; then
        entries+=(
          $'logs\t查看测试服日志\tCtrl-C 只退出日志'
          $'pause\t暂时停止测试服\t保留会话，之后可以继续'
        )
      fi
      entries+=(
        $'failed\t测试有问题：结束本次测试\t清理测试副本；保留备份和候选变更'
        $'changes\t继续修改候选整合包\t添加、更新、移除或校验模组'
      )
    else
      if (( DASH_STAGING_DATASETS > 0 )); then
        entries+=(
          "cleanup_legacy"$'\t'"清理旧测试数据（$DASH_STAGING_USAGE）"$'\t'"只删除 runtime/staging 中的世界副本"
        )
      elif [[ "$DASH_PACK_DIRTY" == true && "$DASH_PACK_ACCEPTED" == true ]]; then
        entries+=(
          $'publish\t发布已测试的变更\t选择小更新、完整更新或稍后处理'
          $'start\t重新测试当前整合包\t新建一次隔离测试会话'
        )
      elif [[ "$DASH_PACK_DIRTY" == true ]]; then
        entries+=(
          $'start\t开始测试候选整合包\t只在开始时为正式服备份一次'
        )
      fi
      entries+=(
        $'changes\t修改候选整合包\t添加、更新、移除或校验模组'
        $'client_build\t构建客户端包\t创建并验证当前 .mrpack'
      )
    fi
    entries+=( $'__back\t返回\t回到主菜单' )

    selected="$(menu_select "$menu_title" "${entries[@]}")"
    case "$selected" in
      start)
        run_menu_command "开始整合包测试" command_stage start
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        ;;
      resume)
        run_menu_command "继续整合包测试" command_stage resume
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        ;;
      rebuild)
        run_menu_command "重建测试服" command_stage rebuild
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        ;;
      logs) run_menu_command --read "测试服日志" command_stage logs ;;
      pause)
        run_menu_command "暂停测试服" command_stage stop
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        ;;
      finish)
        delete_option="--keep-backup"
        if [[ "$DASH_SESSION_BACKUP_STATUS" == "tracked" ]]; then
          if confirm_default_yes "删除本次测试专用备份吗？"; then
            delete_option="--delete-backup"
          fi
        elif [[ "$DASH_SESSION_BACKUP_STATUS" == "untracked" ]]; then
          warn "无法唯一确认本次测试创建的备份，因此会保留它。"
        fi
        run_menu_command "完成测试并清理" command_stage finish "$delete_option" --confirm
        if [[ "$MENU_LAST_STATUS" -eq 0 ]]; then
          menu_publish_handoff
          return 0
        fi
        ;;
      failed)
        run_menu_command "结束有问题的测试" command_stage discard --confirm
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        ;;
      cleanup_legacy)
        printf '\n将释放 %s；只清理 runtime/staging/data 和 data.previous.*。\n' \
          "$DASH_STAGING_USAGE" >&2
        if confirm_yes "确认清理这些旧测试副本吗？"; then
          run_menu_command "清理旧测试数据" command_stage cleanup --confirm
        else
          menu_cancelled
        fi
        ;;
      changes) menu_mods ;;
      client_build) run_menu_command "构建客户端整合包" command_client build ;;
      publish)
        menu_publish_handoff
        return 0
        ;;
      __back) return 0 ;;
    esac
  done
}

menu_more_tools() {
  local selected command_text menu_title
  while true; do
    menu_prepare_title menu_title '更多工具'
    selected="$(menu_select "$menu_title" \
      $'status\t正式服详细状态\t显示 Compose 服务和本机地址' \
      $'logs\t正式服日志\tCtrl-C 只退出日志' \
      $'console\t正式服控制台\t使用 Ctrl-P、Ctrl-Q 依次分离' \
      $'rcon\t执行 Minecraft 命令\t通过内部 RCON 发送一条命令' \
      $'restart\t安全重启正式服\t保存、备份、停止后重新启动' \
      $'stop_skip\t关服并跳过远端备份\t仍创建必要的本机备份' \
      $'init\t初始化本机文件\t创建缺少的 .env、密钥和 runtime 目录' \
      $'edit\t编辑 .env\t保存后立即校验世界设置' \
      $'doctor\t运行诊断\t检查依赖、设置、Docker 和发布元数据' \
      $'help\t完整命令参考\t显示高级非交互命令' \
      $'__back\t返回\t回到主菜单')"
    case "$selected" in
      status) run_menu_command --read "正式服务器详情" command_status ;;
      logs) run_menu_command --read "正式服务器日志" command_production_logs ;;
      console) run_menu_command --read "正式服务器控制台" command_console ;;
      rcon)
        command_text="$(prompt_value 'Minecraft 命令（不要输入 /）：')" \
          || { menu_cancelled; continue; }
        run_menu_command --read "RCON: $command_text" run_rcon_command "$command_text"
        ;;
      restart)
        if confirm_yes "要安全停止并重启正式服吗？"; then
          run_menu_command "重启正式服务器" command_restart
          [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        else menu_cancelled; fi
        ;;
      stop_skip)
        if confirm_yes "要停止正式服并跳过远端备份吗？"; then
          run_menu_command "跳过远端备份并关服" command_stop --skip-remote
          [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
        else menu_cancelled; fi
        ;;
      init) run_menu_command "初始化本机文件" command_init ;;
      edit) run_menu_command "编辑本机配置" menu_edit_env ;;
      doctor) run_menu_command --read "环境诊断" command_doctor ;;
      help) run_menu_command --read "高级命令参考" usage_all ;;
      __back) return 0 ;;
    esac
  done
}

command_menu() {
  MENU_PLAIN=false
  MENU_FZF=false
  case "${1:-}" in
    "") ;;
    --plain) MENU_PLAIN=true ;;
    *) die "用法：./mcctl menu [--plain]" ;;
  esac
  if [[ "$MENU_PLAIN" == true ]]; then
    MENU_FZF=false
  elif [[ ! -t 0 || ! -t 1 ]] || ! command -v fzf >/dev/null 2>&1; then
    MENU_PLAIN=true
  else
    MENU_FZF=true
  fi

  local selected server_action server_label server_description
  while true; do
    dashboard_collect
    dashboard_render
    if [[ "$DASH_PRODUCTION" == "healthy" || "$DASH_PRODUCTION" == "running" \
      || "$DASH_PRODUCTION" == "starting" || "$DASH_PRODUCTION" == "unhealthy" ]]; then
      server_action="server_stop"
      server_label="安全停止正式服"
      server_description="通知玩家、保存并备份后停止"
    else
      server_action="server_start"
      server_label="启动正式服"
      server_description="创建停服快照后启动"
    fi
    selected="$(menu_select '今天要做什么？' \
      "$server_action"$'\t'"$server_label"$'\t'"$server_description" \
      $'players\t管理玩家\t在线玩家、白名单和 OP 权限' \
      "pack"$'\t'"维护整合包"$'\t'"$DASH_WORKFLOW" \
      "world_backup"$'\t'"备份与恢复"$'\t'"本机 $DASH_BACKUP_USAGE；世界状态、备份和恢复" \
      $'more\t更多工具\t状态、日志、控制台、设置和诊断' \
      $'quit\t退出\t不做任何更改并离开 mcctl')"
    case "$selected" in
      server_start) run_menu_command "启动正式服务器" command_start ;;
      server_stop)
        if confirm_yes "要通知玩家、保存、备份并停止正式服吗？"; then
          run_menu_command "安全停止正式服务器" command_stop
        else menu_cancelled; fi
        ;;
      players) menu_players ;;
      pack) menu_pack_workflow ;;
      world_backup) menu_world_backup ;;
      more) menu_more_tools ;;
      quit|__back) break ;;
    esac
  done
}

main() {
  local command="${1:-}"
  shift || true
  if [[ -z "$command" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      command_menu
    else
      usage
    fi
    return 0
  fi
  case "$command" in
    menu) command_menu "$@" ;;
    doctor) [[ $# -eq 0 ]] || die "Usage: ./mcctl doctor"; command_doctor ;;
    init) command_init "$@" ;;
    start) command_start "$@" ;;
    stop) command_stop "$@" ;;
    restart) command_restart "$@" ;;
    status) command_status "$@" ;;
    logs) command_production_logs "$@" ;;
    console) command_console "$@" ;;
    rcon) run_rcon_command "$@" ;;
    whitelist) run_whitelist_command "$@" ;;
    mod) command_mod "$@" ;;
    world) command_world "$@" ;;
    stage) command_stage "$@" ;;
    backup) command_backup "$@" ;;
    backup-list) [[ $# -eq 0 ]] || die "Usage: ./mcctl backup-list"; command_backup_list ;;
    backup-delete) command_backup_delete "$@" ;;
    restore-test) command_restore_test "$@" ;;
    restore) command_restore "$@" ;;
    client) command_client "$@" ;;
    help)
      case "${1:-}" in
        "") usage ;;
        --all) [[ $# -eq 1 ]] || die "Usage: ./mcctl help [--all]"; usage_all ;;
        *) die "Usage: ./mcctl help [--all]" ;;
      esac
      ;;
    -h|--help) [[ $# -eq 0 ]] || die "Usage: ./mcctl help [--all]"; usage ;;
    *) die "Unknown command: $command. Run './mcctl help'." ;;
  esac
}

main "$@"
