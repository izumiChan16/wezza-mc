doctor_item() {
  local level="$1" label="$2" detail="$3"
  printf '%-5s %-24s %s\n' "$level" "$label" "$detail"
}

command_doctor() {
  local failures=0 warnings=0 dependency
  printf 'Wezza MC 环境诊断\n\n'
  for dependency in bash python3 git docker tar zstd openssl; do
    if command -v "$dependency" >/dev/null 2>&1; then
      doctor_item OK "$dependency" "$(command -v "$dependency")"
    else
      doctor_item FAIL "$dependency" "缺少必需命令"
      failures=$((failures + 1))
    fi
  done
  if command -v fzf >/dev/null 2>&1; then
    doctor_item OK fzf "可使用方向键搜索菜单"
  else
    doctor_item WARN fzf "未安装，将自动使用编号菜单"
    warnings=$((warnings + 1))
  fi
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    doctor_item OK "Docker Compose" "CLI 插件可用"
  else
    doctor_item FAIL "Docker Compose" "缺少 docker compose CLI 插件"
    failures=$((failures + 1))
  fi

  if [[ -f "${ROOT_DIR}/.env" ]]; then
    doctor_item OK .env "文件存在"
    if load_settings && validate_world_config >/dev/null 2>&1; then
      doctor_item OK "世界配置" "有效"
    else
      doctor_item FAIL "世界配置" "无效，请编辑 .env 后重试"
      failures=$((failures + 1))
    fi
    if [[ "${EULA:-FALSE}" == "TRUE" ]]; then
      doctor_item OK EULA "已由本机管理员接受"
    else
      doctor_item WARN EULA "请本人阅读 Minecraft EULA 后设置 EULA=TRUE"
      warnings=$((warnings + 1))
    fi
    if [[ "${PACKWIZ_URL:-}" == https://* \
      && "${PACKWIZ_URL:-}" != *YOUR_GITHUB_USER* \
      && "${PACKWIZ_URL:-}" != *example.invalid* ]]; then
      doctor_item OK PACKWIZ_URL "$PACKWIZ_URL"
    else
      doctor_item FAIL PACKWIZ_URL "必须是真实的 HTTPS pack.toml 地址"
      failures=$((failures + 1))
    fi
  else
    doctor_item FAIL .env "缺少，请执行 './mcctl init'"
    failures=$((failures + 1))
  fi

  local secret secret_mode secret_mode_value
  for secret in rcon_password.txt restic_password.txt aws_credentials; do
    if [[ -s "${ROOT_DIR}/secrets/${secret}" ]]; then
      secret_mode="$(stat -c '%a' "${ROOT_DIR}/secrets/${secret}" 2>/dev/null || printf 'unknown')"
      if [[ "$secret_mode" =~ ^[0-7]{3,4}$ ]]; then
        secret_mode_value="$(printf '%d' "0${secret_mode}" 2>/dev/null || printf '511')"
      else
        secret_mode_value=511
      fi
      if (( (secret_mode_value & 63) == 0 )); then
        doctor_item OK "secrets/$secret" "文件存在，权限 $secret_mode"
      else
        doctor_item WARN "secrets/$secret" "权限 $secret_mode 过宽，建议 chmod 600"
        warnings=$((warnings + 1))
      fi
    else
      doctor_item FAIL "secrets/$secret" "缺少或为空，请执行 './mcctl init'"
      failures=$((failures + 1))
    fi
  done

  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    doctor_item OK Docker "守护进程可访问"
    if compose config --quiet >/dev/null 2>&1; then
      doctor_item OK Compose "配置有效"
    else
      doctor_item FAIL Compose "配置校验失败"
      failures=$((failures + 1))
    fi
  else
    doctor_item WARN Docker "不可用，请启动 Docker Desktop 并启用 WSL integration"
    warnings=$((warnings + 1))
  fi

  if python3 "${ROOT_DIR}/tools/release_pack.py" release-check \
    --pack-dir "${ROOT_DIR}/pack" --release "$RELEASE_FILE" >/dev/null 2>&1; then
    doctor_item OK "发布元数据" "与当前整合包一致"
  else
    doctor_item FAIL "发布元数据" "release-check 校验失败"
    failures=$((failures + 1))
  fi

  printf '\n诊断完成：%d 个错误，%d 个警告。\n' "$failures" "$warnings"
  (( failures == 0 ))
}

run_rcon_command() {
  [[ $# -ge 1 ]] || die "Usage: ./mcctl rcon <command...>"
  load_settings
  docker_ready
  service_running minecraft || die "The production server is not running."
  compose exec -T minecraft rcon-cli "$*"
}

run_whitelist_command() {
  local action="${1:-}" player="${2:-}"
  case "$action" in
    add|remove)
      [[ $# -eq 2 && -n "$player" ]] || die "Usage: ./mcctl whitelist add|remove <player>"
      run_rcon_command "whitelist $action $player"
      ;;
    list)
      [[ $# -eq 1 ]] || die "Usage: ./mcctl whitelist list"
      run_rcon_command 'whitelist list'
      ;;
    *) die "Usage: ./mcctl whitelist add|remove|list [player]" ;;
  esac
}

menu_cancelled() {
  info "操作已取消，没有进行任何更改。"
}

prompt_player() {
  local player
  player="$(prompt_value 'Minecraft 玩家名：')" || return 1
  if [[ ! "$player" =~ ^[A-Za-z0-9_]{3,16}$ ]]; then
    warn "玩家名必须由 3–16 个英文字母、数字或下划线组成。"
    return 1
  fi
  printf '%s\n' "$player"
}

select_mod_slug() {
  local path slug name selected
  local -a entries=()
  for path in "${ROOT_DIR}"/pack/mods/*.pw.toml; do
    [[ -f "$path" ]] || continue
    slug="$(basename "$path" .pw.toml)"
    name="$(sed -n 's/^name = "\(.*\)"$/\1/p' "$path" | head -n 1)"
    [[ -n "$name" ]] || name="Packwiz metadata"
    entries+=("${slug}"$'\t'"${slug}"$'\t'"${name}")
  done
  (( ${#entries[@]} > 0 )) || { warn "没有找到模组元数据。"; return 1; }
  selected="$(menu_select '选择模组' "${entries[@]}")"
  [[ "$selected" != "__back" ]] || return 1
  printf '%s\n' "$selected"
}

select_backup_id() {
  local epoch scope size filename timestamp selected
  local -a entries=()
  while IFS=$'\t' read -r epoch scope size filename; do
    [[ -n "$filename" ]] || continue
    timestamp="$(date -d "@${epoch%.*}" '+%Y-%m-%d %H:%M' 2>/dev/null || printf '时间未知')"
    entries+=("${scope}/${filename}"$'\t'"${scope}/${filename}"$'\t'"${timestamp} · $(format_bytes "$size")")
  done < <(
    {
      find "$LOCAL_BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
        -printf '%T@\tlocal\t%s\t%f\n' 2>/dev/null
      find "$OFFLINE_BACKUP_DIR" -maxdepth 1 -type f \
        \( -name '*.tar.zst' -o -name '*.tgz' -o -name '*.tar.gz' \) \
        -printf '%T@\toffline\t%s\t%f\n' 2>/dev/null
    } | sort -rn
  )
  (( ${#entries[@]} > 0 )) || { warn "没有找到本机备份归档。"; return 1; }
  selected="$(menu_select '选择备份归档' "${entries[@]}")"
  [[ "$selected" != "__back" ]] || return 1
  printf '%s\n' "$selected"
}

menu_edit_env() {
  [[ -f "${ROOT_DIR}/.env" ]] || command_init
  local editor_value="${VISUAL:-${EDITOR:-nano}}"
  local -a editor_command=()
  read -r -a editor_command <<< "$editor_value"
  (( ${#editor_command[@]} > 0 )) || die "VISUAL 和 EDITOR 均为空。"
  command -v "${editor_command[0]}" >/dev/null 2>&1 \
    || die "找不到编辑器 ${editor_command[0]}，请设置 VISUAL 或 EDITOR。"
  info "正在打开 .env；只有本人阅读 Minecraft EULA 后才可设置 EULA=TRUE。"
  "${editor_command[@]}" "${ROOT_DIR}/.env"
  validate_world_config || die "保存后的世界配置无效。"
  info "已保存 .env 并校验世界设置；可运行 doctor 完成全部检查。"
}

menu_players() {
