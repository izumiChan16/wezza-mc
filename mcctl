menu_world_backup() {
  local selected mode seed world_name backup_id phrase menu_title
  while true; do
    collect_backup_stats
    menu_title="世界与备份 · local ${BACKUP_LOCAL_COUNT} 个/$(format_bytes "$BACKUP_LOCAL_BYTES") · offline ${BACKUP_OFFLINE_COUNT} 个/$(format_bytes "$BACKUP_OFFLINE_BYTES") · 总计 $(format_bytes "$BACKUP_TOTAL_BYTES")"
    selected="$(menu_select "$menu_title" \
      $'world_status\t世界状态\t显示路径、大小、种子设置和归档' \
      $'world_reset\t重置世界\t归档当前世界并配置新种子' \
      $'backup_create\t创建备份\t在线协调备份或停服快照' \
      $'backup_list\t列出备份\t显示 local、offline 和总占用' \
      $'restore_test\t测试备份\t解压到隔离的 runtime/restore-test' \
      $'restore\t恢复正式服\t可恢复地替换已停止的正式服数据' \
      $'backup_delete\t删除备份\t使用 Y/N 确认并永久删除一个本机归档' \
      $'__back\t返回\t返回状态总览')"
    case "$selected" in
    world_status) run_menu_command "世界状态" command_world status ;;
    world_reset)
      mode="$(menu_select '选择下一个世界的种子' \
        $'random\t随机种子\t清空 WORLD_SEED 以随机生成' \
        $'seed\t指定种子\t输入一个有符号 64 位整数' \
        $'__back\t返回\t取消操作')"
      [[ "$mode" != "__back" ]] || continue
      if [[ "$mode" == "seed" ]]; then
        seed="$(prompt_value '有符号 64 位种子：')" || { menu_cancelled; continue; }
        if ! validate_world_seed "$seed" >/dev/null 2>&1; then
          warn "Minecraft 种子不是有效的有符号 64 位整数。"
          menu_pause
          continue
        fi
      else
        seed="随机"
      fi
      load_settings || { warn "无法加载 .env。"; menu_pause; continue; }
      world_name="${WORLD_NAME:-world}"
      phrase="RESET $world_name"
      printf '\n目标世界：%s\n新种子：%s\n正式服和测试服必须停止；操作前会先创建完整快照。\n' \
        "$world_name" "$seed" >&2
      if ! confirm_phrase "$phrase"; then menu_cancelled; continue; fi
      if [[ "$mode" == "seed" ]]; then
        run_menu_command "重置世界 $world_name" command_world reset --seed "$seed" --confirm
      else
        run_menu_command "重置世界 $world_name" command_world reset --random --confirm
      fi
      [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
      ;;
    backup_create) run_menu_command "创建备份" command_backup ;;
    backup_list) run_menu_command "本机备份归档" command_backup_list ;;
    restore_test)
      backup_id="$(select_backup_id)" || continue
      run_menu_command "测试恢复 $backup_id" command_restore_test "$backup_id"
      ;;
    restore)
      backup_id="$(select_backup_id)" || continue
      printf '\n正式服必须停止；现有数据会保留为 data.pre-restore.*。\n' >&2
      if confirm_phrase "RESTORE $backup_id"; then
        run_menu_command "从 $backup_id 恢复正式服" command_restore "$backup_id" --confirm
        [[ "$MENU_LAST_STATUS" -eq 0 ]] && return 0
      else menu_cancelled; fi
      ;;
    backup_delete)
      backup_id="$(select_backup_id)" || continue
      printf '\n这会永久删除一个本机归档，不影响远端 restic 快照。\n' >&2
      if confirm_yes "确认删除 $backup_id 吗？"; then
        run_menu_command "删除备份 $backup_id" command_backup_delete "$backup_id" --confirm
      else menu_cancelled; fi
      ;;
    __back) return 0 ;;
    esac
  done
}

