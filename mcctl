menu_mods() {
  local selected source slug side menu_title
  while true; do
    menu_prepare_title menu_title '修改候选整合包'
    selected="$(menu_select "$menu_title" \
      $'list\t列出模组\t显示 slug、安装侧、来源和名称' \
      $'add\t添加模组\t使用 Modrinth slug、CurseForge 或 HTTPS URL' \
      $'update_check\t检查更新\t在临时整合包副本中比较' \
      $'update_one\t更新一个模组\t从列表选择，无需手输 slug' \
      $'update_all\t更新全部模组\t校验通过后应用本地候选版本' \
      $'side\t修改安装侧\t设为仅客户端、仅服务端或双方' \
      $'remove\t移除模组\t将元数据移到可恢复的 runtime 目录' \
      $'check\t刷新并校验\t更新 Packwiz 索引并执行规则检查' \
      $'client_build\t构建客户端包\t创建并验证当前 .mrpack' \
      $'__back\t返回\t返回状态总览')"
    case "$selected" in
    list) run_menu_command --read "当前模组" command_mod list ;;
    add)
      source="$(prompt_value 'Modrinth slug 或模组 URL：')" || { menu_cancelled; continue; }
      run_menu_command "添加候选模组" command_mod add "$source"
      ;;
    update_check) run_menu_command --read "检查模组更新" command_mod update-check ;;
    update_one)
      slug="$(select_mod_slug)" || { menu_cancelled; continue; }
      run_menu_command "更新 $slug" command_mod update "$slug"
      ;;
    update_all)
      if confirm_yes "要更新所有存在有效候选版本的模组吗？"; then
        run_menu_command "更新全部模组" command_mod update all
      else menu_cancelled; fi
      ;;
    side)
      slug="$(select_mod_slug)" || { menu_cancelled; continue; }
      side="$(menu_select "选择 $slug 的安装侧" \
        $'client\t仅客户端\t只安装到玩家整合包' \
        $'server\t仅服务端\t只安装到服务器' \
        $'both\t客户端与服务端\t双方都安装' \
        $'__back\t返回\t取消操作')"
      [[ "$side" != "__back" ]] || continue
      run_menu_command "修改 $slug 安装侧" command_mod side "$slug" "$side"
      ;;
    remove)
      slug="$(select_mod_slug)" || { menu_cancelled; continue; }
      if confirm_yes "要从候选整合包移除 $slug 吗？元数据仍可恢复。"; then
        run_menu_command "移除 $slug" command_mod remove "$slug"
      else menu_cancelled; fi
      ;;
    check) run_menu_command "刷新并校验整合包" command_mod check ;;
    client_build) run_menu_command "构建客户端整合包" command_client build ;;
    __back) return 0 ;;
    esac
  done
}

