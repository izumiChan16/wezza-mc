    doctor) run_menu_command "环境诊断" command_doctor ;;
    start)
      if confirm_yes "要启动正式服务器吗？"; then
        run_menu_command "启动正式服务器" command_start
      else menu_cancelled; fi
      ;;
    server_status) run_menu_command "正式服务器详情" command_status ;;
    stage_start)
      if confirm_yes "要为候选整合包创建全新测试副本吗？"; then
        run_menu_command "启动测试服" command_stage start
      else menu_cancelled; fi
      ;;
    stage_accept)
      if confirm_yes "确认当前健康的测试服已经过测试吗？"; then
        run_menu_command "接受测试服整合包" command_stage accept
      else menu_cancelled; fi
      ;;
    stage_logs) run_menu_command "测试服日志" command_stage logs ;;
    publish) menu_release ;;
  esac
}

command_menu() {
  MENU_PLAIN=false
  MENU_FZF=false
  case "${1:-}" in
    "") ;;
    --plain) MENU_PLAIN=true ;;
    *) die "用法：./mcctl menu [--plain]" ;;
  esac
  if [[ "$MENU_PLAIN" == true ]]; then
    MENU_FZF=false
  elif [[ ! -t 0 || ! -t 1 ]] || ! command -v fzf >/dev/null 2>&1; then
    MENU_PLAIN=true
  else
    MENU_FZF=true
  fi

  local selected
  while true; do
    dashboard_collect
    dashboard_render
    selected="$(menu_select '主菜单' \
      "recommended"$'\t'"★ 建议：$DASH_RECOMMENDED_LABEL"$'\t'"根据当前本机状态生成" \
      $'server\t正式服务器\t启动、停止、状态、日志、控制台和 RCON' \
      $'players\t玩家与权限\t在线玩家、白名单、OP 与撤销 OP' \
      $'mods\t模组与客户端包\t添加、更新、移除、校验和构建' \
      $'release\t测试服与发布\t测试、接受并发布整合包变更' \
      $'world_backup\t世界与备份\t检查、重置、备份、恢复和删除' \
      $'settings\t设置与诊断\t初始化、编辑 .env、诊断和帮助' \
      $'refresh\t刷新状态\t重新检测当前状态' \
      $'quit\t退出\t不做任何更改并离开 mcctl')"
    case "$selected" in
      recommended) menu_recommended ;;
      server) menu_server ;;
      players) menu_players ;;
      mods) menu_mods ;;
      release) menu_release ;;
      world_backup) menu_world_backup ;;
      settings) menu_settings ;;
      refresh) continue ;;
      quit|__back) break ;;
    esac
  done
}

main() {
  local command="${1:-}"
  shift || true
  if [[ -z "$command" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      command_menu
    else
      usage
    fi
    return 0
  fi
  case "$command" in
    menu) command_menu "$@" ;;
    doctor) [[ $# -eq 0 ]] || die "Usage: ./mcctl doctor"; command_doctor ;;
    init) command_init "$@" ;;
    start) command_start "$@" ;;
    stop) command_stop "$@" ;;
    restart) command_restart "$@" ;;
    status) command_status "$@" ;;
    logs) command_production_logs "$@" ;;
    console) command_console "$@" ;;
    rcon) run_rcon_command "$@" ;;
    whitelist) run_whitelist_command "$@" ;;
    mod) command_mod "$@" ;;
    world) command_world "$@" ;;
    stage) command_stage "$@" ;;
    backup) command_backup "$@" ;;
    backup-list) [[ $# -eq 0 ]] || die "Usage: ./mcctl backup-list"; command_backup_list ;;
    backup-delete) command_backup_delete "$@" ;;
    restore-test) command_restore_test "$@" ;;
    restore) command_restore "$@" ;;
    client) command_client "$@" ;;
    help)
      case "${1:-}" in
        "") usage ;;
        --all) [[ $# -eq 1 ]] || die "Usage: ./mcctl help [--all]"; usage_all ;;
        *) die "Usage: ./mcctl help [--all]" ;;
      esac
      ;;
    -h|--help) [[ $# -eq 0 ]] || die "Usage: ./mcctl help [--all]"; usage ;;
    *) die "Unknown command: $command. Run './mcctl help'." ;;
  esac
}

main "$@"
